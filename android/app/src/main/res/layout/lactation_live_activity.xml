<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lactation_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/lactation_notification_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lactation_side"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/lactation_notification_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/lactation_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format="%s"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/lactation_notification_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lactation_button_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/lactation_btn_pause"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/lactation_action_pause"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_pause" />

        <FrameLayout
            android:id="@+id/lactation_stop_container"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/lactation_btn_stop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/lactation_action_stop"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_stop" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
